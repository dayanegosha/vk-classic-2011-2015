{
  "manifest_version": 3,
  "name": "ВК Классика · 2011–2015",
  "version": "1.2.0",
  "description": "Классическое оформление ВКонтакте: синяя шапка, текстовое меню, белый фон и квадратные аватарки.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "ВК Классика",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vk.com/*",
        "https://www.vk.com/*",
        "https://vk.ru/*",
        "https://www.vk.ru/*"
      ],
      "exclude_matches": [
        "https://*/login*",
        "https://*/join*",
        "https://*/restore*"
      ],
      "js": [
        "settings.js",
        "diagnostics.js",
        "content.js"
      ],
      "css": [
        "light-theme.css",
        "classic.css"
      ],
      "run_at": "document_start"
    }
  ]
}
